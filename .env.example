# Chaves do Supabase. Pegue em: painel do Supabase > botão "Connect" (ou Project Settings > API Keys).
# A chave publishable (ou "anon") pode ficar no app; a segurança dos dados vem das regras do banco (RLS).
# NUNCA coloque aqui a chave "secret" / "service_role".
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# E-mails do app (recuperar senha) pelo Brevo. Usadas só pelo comando "supabase config push",
# NÃO vão para dentro do app (não começam com EXPO_PUBLIC_). Nunca suba a chave SMTP para o GitHub.
# Login SMTP (Brevo > SMTP & API > aba SMTP), algo como 1234abc@smtp-brevo.com
SUPABASE_AUTH_EMAIL_SMTP_USER=
# Chave SMTP gerada no Brevo (não é a senha da sua conta)
SUPABASE_AUTH_EMAIL_SMTP_PASS=
# E-mail remetente verificado no Brevo (Senders), de onde os e-mails vão sair
SUPABASE_AUTH_EMAIL_SMTP_SENDER=
