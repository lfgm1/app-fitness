{
  "expo": {
    "name": "Gains Club",
    "slug": "gains-club",
    "scheme": "gainsclub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gainsclub.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "x-apple-health"
        ]
      }
    },
    "android": {
      "package": "com.gainsclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#C6F432",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Gains Club",
      "shortName": "Gains Club",
      "lang": "pt-BR",
      "description": "Registre seus treinos e acompanhe sua progressão de carga.",
      "themeColor": "#0E0F12",
      "backgroundColor": "#0E0F12"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-sharing",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Gains Club lê seus passos do Apple Saúde para mostrar sua contagem diária e a meta de passos.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
